# Gemini AI API anahtarı — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Adzuna geliştirici hesabından alınır: https://developer.adzuna.com/
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# Adzuna Türkiye pazarı hesabında açıksa tr olarak bırakın.
ADZUNA_COUNTRY=tr

# Careerjet Publisher hesabından alınır: https://www.careerjet.com.tr/partners/publishers
CAREERJET_API_KEY=your_careerjet_api_key

# Jooble API anahtarı — https://jooble.org/api/about
JOOBLE_API_KEY=your_jooble_api_key
